    C --> C4[Consent Management]
    C --> C5[Data Sharing]
    C --> C6[Storage & Security]
    C --> C7[User Rights]
    C --> C8[Cookies & Tracking]
    C --> C9[International Data Transfers]
    C --> C10[Policy Updates]
    C --> C11[Contact Information]
    
    %% Search Box
