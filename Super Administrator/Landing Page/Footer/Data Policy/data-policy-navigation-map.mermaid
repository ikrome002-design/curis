    %% Style definitions
    classDef mainPage fill:#f9f,stroke:#333,stroke-width:2px;
    classDef section fill:#bbf,stroke:#33f,stroke-width:1px;
    classDef popup fill:#fbb,stroke:#f33,stroke-width:1px;
    classDef button fill:#bfb,stroke:#3f3,stroke-width:1px;
    classDef result fill:#ffb,stroke:#bb3,stroke-width:1px;
    
    class A,B mainPage;
    class C,D,E,F,G,C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11 section;
    class F1A,F2A,F3A,F4A,G1A,G4A,PC2A,UR1A,UR3B popup;
    class F2E,F2F,F3D,F4E,G1D,G4D,UR1B,UR3A button;
    class F2G,F3E,G1E,G4E,UR1D,UR3D result;