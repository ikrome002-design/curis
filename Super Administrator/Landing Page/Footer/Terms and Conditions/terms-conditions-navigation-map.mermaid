    C --> C8[Limitation of Liability]
    C --> C9[Modification of Terms]
    C --> C10[Termination]
    C --> C11[Governing Law]
    C --> C12[Contact Information]
    
    %% Expandable Sections
    D --> D1{Toggle Section}
    D1 --> D2[Expand Section]
    D1 --> D3[Collapse Section]
    
    %% Search Functionality
    E --> E1[Enter Search Term]
    E1 --> E2[View Search Results]
    E2 --> E3{Click Result}
