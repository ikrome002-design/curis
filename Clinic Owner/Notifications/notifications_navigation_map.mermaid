    classDef navigationBox fill:#fce4ec,stroke:#c2185b,stroke-width:2px
    classDef integrationBox fill:#e0f2f1,stroke:#00695c,stroke-width:2px
    classDef emergencyBox fill:#ffcdd2,stroke:#d32f2f,stroke-width:3px
    
