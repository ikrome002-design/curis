.env
.env.*
!.env.example
!.env.testing.example
!.env.staging.example
!.env.production.example
.env.backup
.env.bak
.env.local
.env.development.local
.env.test.local
.env.staging.local
.env.production.local
# Local PHP/Laravel environment helpers
.phpunit.result.cache
.phpunit.cache/
.phpactor.json
.php-cs-fixer.cache
.pint.cache
